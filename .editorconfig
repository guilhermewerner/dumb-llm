root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[.env*]
insert_final_newline = false

[.gitmodules]
indent_style = tab

[*.bat]
end_of_line = crlf

[*.ini]
end_of_line = crlf

[*.md]
indent_size = 1
trim_trailing_whitespace = false
